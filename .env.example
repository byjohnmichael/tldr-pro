# Only needed for local runs. In GitHub Actions these are repository secrets.

# Claude plan token from `claude setup-token`. Not needed locally if you're logged in to Claude Code.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxx

# iCloud SMTP (sends the digest). App-specific password, not your Apple ID password.
ICLOUD_EMAIL=byjohnmichael@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=tldr@byjohnmichael.com

# Optional: overrides to_email in config.yaml
# TO_EMAIL=you@example.com
